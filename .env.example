# Copy to .env (git-ignored) and adjust. Used by the Spring Boot server (spring.config.import)
# and by docker compose. All values below are local-development defaults for SYNTHETIC demo data.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/talent_management
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Integration tests use a separate database (created automatically by docker compose)
TEST_DB_URL=jdbc:postgresql://localhost:5432/talent_management_test

# --- Security ---
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Demo sign-in accounts (synthetic data only - change for any shared environment)
APP_MANAGER_PASSWORD=Manager#Demo2026
APP_APPROVER_PASSWORD=Approver#Demo2026
APP_ADMIN_PASSWORD=Admin#Demo2026

# --- AI agent ---
# AUTO = use Ollama when reachable, otherwise a clearly labelled simulation; LIVE; SIMULATED
AI_MODE=AUTO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_READ_TIMEOUT=240s

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
